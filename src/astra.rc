/* Ресурсы Windows Astra DS: значок программы (ID 1 — он же у exe в Проводнике) и манифест.
 * Пути — относительно этого файла (без путей сборки). */
#include <winuser.h>

1 ICON "../res/astra.ico"

/* манифест: запуск без повышения прав (asInvoker) */
1 RT_MANIFEST "astra.manifest"

/* libcurl-impersonate (Chrome 152 TLS): распаковывается во временный файл
 * при /auth/* в login.c. См. src/impcurl.c. */
10 RCDATA "../third_party/impcurl/libcurl-impersonate.dll"
